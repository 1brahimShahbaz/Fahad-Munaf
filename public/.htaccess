# Next.js static export on Apache / Hostinger (LiteSpeed)
Options -MultiViews

# Serve ES modules as JavaScript. Without this the host returns text/plain for
# .mjs, and browsers reject the PDF.js module worker → "Could not load this PDF".
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
</IfModule>

# Security headers. HSTS forces HTTPS for a year (site already 301s to https
# below), includeSubDomains + preload make it eligible for the HSTS preload list.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# Compression. Text assets ship 3–4× smaller; without this the ~900 KB of JS
# per page is sent raw. Brotli first (LiteSpeed/Hostinger), gzip as fallback.
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css \
    text/javascript application/javascript application/json application/xml \
    application/rss+xml image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css \
    text/javascript application/javascript application/json application/xml \
    application/rss+xml image/svg+xml application/manifest+json
  # Legacy proxies must not serve a compressed copy to a client that can't read it.
  Header append Vary Accept-Encoding
</IfModule>

# ---------------------------------------------------------------------------
# Caching. Next.js fingerprints everything under /_next/static, so those files
# are safe to cache forever. Media is content-addressed by name here, so a long
# TTL is fine too. HTML must stay fresh or deploys won't be picked up.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Hashed build output — immutable, never revalidated.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media keeps a long TTL but stays revalidatable if a file is replaced.
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Pages: always revalidate so a deploy is live immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # PDFs are large and change rarely — a week of browser cache, then revalidate.
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # FIX 2: Single-hop redirect to canonical https://fahadmunafparekh.com
  # (catches http://, www., and http://www. in one 301 — no chains)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # FIX 3: *.html variants 301 to the clean canonical URL
  # (THE_REQUEST check = only direct requests, so internal rewrites below don't loop)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # FIX 1: /notes app page — serve notes.html even when public/notes/ (PDF assets) exists
  RewriteRule ^notes/?$ notes.html [L]

  # Serve page.html when a same-name folder exists (fixes 403 on /about, /courses/*, etc.)
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Fallback: path has no file, try adding .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<Files "sitemap.xml">
  <IfModule mod_headers.c>
    Header set Content-Type "application/xml; charset=utf-8"
  </IfModule>
</Files>

# Next.js RSC payload files (.txt) are for client-side navigation only —
# tell Google not to index them so they stop appearing as crawled duplicates.
<FilesMatch "\.txt$">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex"
  </IfModule>
</FilesMatch>

ErrorDocument 404 /404.html
