{
  "name": "fahad-munaf-parekh-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-cache.cjs",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "generate:blog": "npx tsx scripts/generate-blog-posts.ts",
    "generate:lectures": "node --env-file-if-exists=.env.local scripts/generate-lectures.mjs",
    "generate:llms": "npx tsx scripts/generate-llms.ts",
    "generate:logo": "node scripts/generate-logo-variants.mjs",
    "generate:banners": "node scripts/generate-banners.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "download:blog-covers": "node scripts/download-blog-covers.mjs",
    "prebuild": "npm run download:blog-covers && npm run generate:blog && npm run generate:lectures && npm run generate:llms && npm run generate:logo && npm run generate:banners && npm run generate:favicons",
    "postbuild": "node scripts/prune-export.cjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib data --ext .ts,.tsx"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@next/third-parties": "14.2.35",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-seo": "^7.2.0",
    "next-sitemap": "^4.2.3",
    "pdfjs-dist": "^5.7.284",
    "react": "^18",
    "react-countup": "^6.5.3",
    "react-dom": "^18",
    "react-hook-form": "^7.75.0",
    "react-intersection-observer": "^10.0.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "to-ico": "^1.1.5",
    "typescript": "^5"
  }
}
