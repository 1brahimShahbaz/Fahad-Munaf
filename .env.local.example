NEXT_PUBLIC_SITE_URL=https://fahadmunafparekh.com

NEXT_PUBLIC_GA_ID=

NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Google Search Console → Settings → Ownership verification (HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Registration form → Google Sheet (see scripts/google-registration-form.gs)
